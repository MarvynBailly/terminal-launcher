<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="terminal_black">#000000</color>

    <!-- Black before the first frame so the launcher never flashes white. Colors after that come from the terminal theme. -->
    <style name="Theme.Terminal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/terminal_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/terminal_black</item>
    </style>
</resources>
